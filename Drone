<svg width="900" height="220" viewBox="0 0 900 220" xmlns="http://www.w3.org/2000/svg">
  <defs>
    <radialGradient id="glowGrad" cx="50%" cy="50%" r="50%">
      <stop offset="0%" style="stop-color:#00d4ff;stop-opacity:0.5"/>
      <stop offset="100%" style="stop-color:#00d4ff;stop-opacity:0"/>
    </radialGradient>
    <radialGradient id="bgGrad" cx="50%" cy="50%" r="50%">
      <stop offset="0%" style="stop-color:#0d1b2a"/>
      <stop offset="100%" style="stop-color:#060d14"/>
    </radialGradient>
    <filter id="glow" x="-50%" y="-50%" width="200%" height="200%">
      <feGaussianBlur in="SourceGraphic" stdDeviation="3" result="blur"/>
      <feMerge><feMergeNode in="blur"/><feMergeNode in="SourceGraphic"/></feMerge>
    </filter>
    <filter id="softglow" x="-80%" y="-80%" width="260%" height="260%">
      <feGaussianBlur in="SourceGraphic" stdDeviation="6" result="blur"/>
      <feMerge><feMergeNode in="blur"/><feMergeNode in="SourceGraphic"/></feMerge>
    </filter>

    <!-- Trail path for drone to follow: wide swirl → tightening spiral → land center -->
    <path id="flightPath" d="
      M -80, 30
      C 100,-60  800,-80  820,60
      C 840,180  600,200  500,130
      C 420,80   380,60   420,100
      C 450,125  460,135  450,140
    "/>
  </defs>

  <!-- Background -->
  <rect width="900" height="220" fill="url(#bgGrad)" rx="16"/>

  <!-- Subtle grid lines -->
  <g stroke="#00d4ff" stroke-width="0.3" opacity="0.08">
    <line x1="0" y1="40" x2="900" y2="40"/>
    <line x1="0" y1="80" x2="900" y2="80"/>
    <line x1="0" y1="120" x2="900" y2="120"/>
    <line x1="0" y1="160" x2="900" y2="160"/>
    <line x1="0" y1="200" x2="900" y2="200"/>
    <line x1="100" y1="0" x2="100" y2="220"/>
    <line x1="200" y1="0" x2="200" y2="220"/>
    <line x1="300" y1="0" x2="300" y2="220"/>
    <line x1="400" y1="0" x2="400" y2="220"/>
    <line x1="500" y1="0" x2="500" y2="220"/>
    <line x1="600" y1="0" x2="600" y2="220"/>
    <line x1="700" y1="0" x2="700" y2="220"/>
    <line x1="800" y1="0" x2="800" y2="220"/>
  </g>

  <!-- Landing pad glow (fades in after drone lands) -->
  <ellipse cx="450" cy="155" rx="55" ry="9" fill="url(#glowGrad)">
    <animate attributeName="opacity" values="0;0;0;0;0;0.7;0.7" keyTimes="0;0.3;0.5;0.7;0.85;0.95;1" dur="4.5s" fill="freeze"/>
    <animate attributeName="rx" values="55;70;55" dur="2s" begin="4.5s" repeatCount="indefinite"/>
  </ellipse>
  <!-- Landing pad rings -->
  <circle cx="450" cy="155" r="28" fill="none" stroke="#00d4ff" stroke-width="0.8" opacity="0">
    <animate attributeName="opacity" values="0;0;0;0;0;0.4;0.4" keyTimes="0;0.3;0.5;0.7;0.85;0.95;1" dur="4.5s" fill="freeze"/>
  </circle>
  <circle cx="450" cy="155" r="18" fill="none" stroke="#00d4ff" stroke-width="0.5" opacity="0">
    <animate attributeName="opacity" values="0;0;0;0;0;0.3;0.3" keyTimes="0;0.3;0.5;0.7;0.85;0.95;1" dur="4.5s" fill="freeze"/>
  </circle>

  <!-- DRONE GROUP -->
  <g id="drone" filter="url(#glow)">
    <!-- Follow the swirl path -->
    <animateMotion
      dur="4s"
      fill="freeze"
      rotate="auto"
      calcMode="spline"
      keyTimes="0;0.25;0.55;0.78;1"
      keySplines="0.3 0 0.7 1; 0.3 0 0.7 1; 0.3 0 0.7 1; 0.1 0 0.3 1"
    >
      <mpath href="#flightPath"/>
    </animateMotion>

    <!-- Hover bob after landing -->
    <animateTransform attributeName="transform" type="translate"
      values="0,0; 0,-5; 0,0; 0,-3; 0,0"
      keyTimes="0;0.25;0.5;0.75;1"
      dur="2.2s" begin="4s" repeatCount="indefinite" additive="sum"/>

    <!-- === DRONE BODY === -->
    <!-- Main chassis -->
    <rect x="-20" y="-7" width="40" height="14" rx="5" fill="#0a1628" stroke="#00d4ff" stroke-width="1.8"/>
    <!-- Center hub -->
    <rect x="-8" y="-11" width="16" height="22" rx="4" fill="#0d1f3c" stroke="#00d4ff" stroke-width="1.2"/>
    <!-- Center dot -->
    <circle cx="0" cy="0" r="3" fill="#00d4ff" opacity="0.6"/>
    <!-- Camera gimbal -->
    <circle cx="0" cy="10" r="4" fill="#0a1628" stroke="#00d4ff" stroke-width="1.2"/>
    <circle cx="0" cy="10" r="2" fill="#00d4ff" opacity="0.8"/>
    <circle cx="0" cy="10" r="0.8" fill="#001a2e"/>

    <!-- Arms - 4 diagonal -->
    <line x1="-18" y1="-5"  x2="-40" y2="-18" stroke="#00d4ff" stroke-width="2" opacity="0.9"/>
    <line x1="18"  y1="-5"  x2="40"  y2="-18" stroke="#00d4ff" stroke-width="2" opacity="0.9"/>
    <line x1="-18" y1="5"   x2="-40" y2="18"  stroke="#00d4ff" stroke-width="2" opacity="0.9"/>
    <line x1="18"  y1="5"   x2="40"  y2="18"  stroke="#00d4ff" stroke-width="2" opacity="0.9"/>

    <!-- Motor housings -->
    <circle cx="-40" cy="-18" r="5" fill="#0a1628" stroke="#00d4ff" stroke-width="1.5"/>
    <circle cx="40"  cy="-18" r="5" fill="#0a1628" stroke="#00d4ff" stroke-width="1.5"/>
    <circle cx="-40" cy="18"  r="5" fill="#0a1628" stroke="#00d4ff" stroke-width="1.5"/>
    <circle cx="40"  cy="18"  r="5" fill="#0a1628" stroke="#00d4ff" stroke-width="1.5"/>

    <!-- === PROPELLERS === -->
    <!-- Front-Left -->
    <g>
      <animateTransform attributeName="transform" type="rotate" from="0 -40 -18" to="360 -40 -18" dur="0.12s" repeatCount="indefinite" additive="sum"/>
      <ellipse cx="-40" cy="-18" rx="14" ry="2.5" fill="#00d4ff" opacity="0.55"/>
      <ellipse cx="-40" cy="-18" rx="2.5" ry="14" fill="#00d4ff" opacity="0.25"/>
    </g>
    <!-- Front-Right -->
    <g>
      <animateTransform attributeName="transform" type="rotate" from="0 40 -18" to="-360 40 -18" dur="0.12s" repeatCount="indefinite" additive="sum"/>
      <ellipse cx="40" cy="-18" rx="14" ry="2.5" fill="#00d4ff" opacity="0.55"/>
      <ellipse cx="40" cy="-18" rx="2.5" ry="14" fill="#00d4ff" opacity="0.25"/>
    </g>
    <!-- Back-Left -->
    <g>
      <animateTransform attributeName="transform" type="rotate" from="0 -40 18" to="-360 -40 18" dur="0.12s" repeatCount="indefinite" additive="sum"/>
      <ellipse cx="-40" cy="18" rx="14" ry="2.5" fill="#00d4ff" opacity="0.55"/>
      <ellipse cx="-40" cy="18" rx="2.5" ry="14" fill="#00d4ff" opacity="0.25"/>
    </g>
    <!-- Back-Right -->
    <g>
      <animateTransform attributeName="transform" type="rotate" from="0 40 18" to="360 40 18" dur="0.12s" repeatCount="indefinite" additive="sum"/>
      <ellipse cx="40" cy="18" rx="14" ry="2.5" fill="#00d4ff" opacity="0.55"/>
      <ellipse cx="40" cy="18" rx="2.5" ry="14" fill="#00d4ff" opacity="0.25"/>
    </g>

    <!-- === LED LIGHTS === -->
    <!-- Red - front left -->
    <circle cx="-40" cy="-18" r="2.5" fill="#ff3333">
      <animate attributeName="opacity" values="1;0.2;1" dur="0.7s" repeatCount="indefinite"/>
    </circle>
    <!-- Green - front right -->
    <circle cx="40" cy="-18" r="2.5" fill="#33ff66">
      <animate attributeName="opacity" values="1;0.2;1" dur="0.7s" begin="0.35s" repeatCount="indefinite"/>
    </circle>
    <!-- Red - back left -->
    <circle cx="-40" cy="18" r="2.5" fill="#ff3333">
      <animate attributeName="opacity" values="1;0.2;1" dur="0.7s" begin="0.2s" repeatCount="indefinite"/>
    </circle>
    <!-- Green - back right -->
    <circle cx="40" cy="18" r="2.5" fill="#33ff66">
      <animate attributeName="opacity" values="1;0.2;1" dur="0.7s" begin="0.55s" repeatCount="indefinite"/>
    </circle>
    <!-- White strobe - belly -->
    <circle cx="0" cy="10" r="1.5" fill="white">
      <animate attributeName="opacity" values="0;1;0" dur="1.2s" repeatCount="indefinite"/>
    </circle>

    <!-- Downward spotlight beam (visible after hover) -->
    <polygon points="0,12 -12,40 12,40" fill="#00d4ff" opacity="0">
      <animate attributeName="opacity" values="0;0;0;0;0;0.12;0.12" keyTimes="0;0.3;0.5;0.7;0.85;0.95;1" dur="4.5s" fill="freeze"/>
    </polygon>
  </g>

  <!-- Scan line sweep decoration -->
  <rect x="0" y="0" width="900" height="4" fill="#00d4ff" opacity="0.03">
    <animateTransform attributeName="transform" type="translate" from="0,0" to="0,220" dur="3s" repeatCount="indefinite"/>
  </rect>

  <!-- Corner brackets -->
  <g stroke="#00d4ff" stroke-width="1.5" fill="none" opacity="0.4">
    <path d="M 12,12 L 12,28 M 12,12 L 28,12"/>
    <path d="M 888,12 L 872,12 M 888,12 L 888,28"/>
    <path d="M 12,208 L 12,192 M 12,208 L 28,208"/>
    <path d="M 888,208 L 872,208 M 888,208 L 888,192"/>
  </g>
</svg>
